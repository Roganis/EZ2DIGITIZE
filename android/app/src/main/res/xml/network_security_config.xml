<!-- The desktop's upload page is plain HTTP on the local network (its URL
     carries a one-time token), at whatever address the computer has, so
     cleartext can't be limited to known domains. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
